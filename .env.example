# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key -- server-only, never expose to the browser, never commit
SUPABASE_SERVICE_ROLE_KEY=

# Euri AI gateway (https://euri.ai) -- OpenAI-compatible, routes to 40+ models
EURI_API_KEY=
# Optional -- defaults to https://api.euron.one/api/v1/euri if unset
EURI_API_BASE=
# Optional fallback only -- gpt-4o-mini is free-tier eligible (10k tokens/day).
# Pick the model per call in code once a stage needs something stronger.
EURI_DEFAULT_MODEL=gpt-4o-mini

# Twilio (Phase 1 voice) -- Account SID/Auth Token from the Twilio console.
# TWILIO_AUTH_TOKEN validates that a webhook request genuinely came from
# Twilio (server-only, never expose to the browser, never commit).
TWILIO_AUTH_TOKEN=
# The one manually-configured test number for this slice -- shown on a
# deployed voice agent's page as "call this number to try it." Not looked
# up per-agent; auto-provisioning real numbers is a later phase.
NEXT_PUBLIC_VOICE_TEST_NUMBER=
