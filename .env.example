# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key -- server-only, never expose to the browser, never commit
SUPABASE_SERVICE_ROLE_KEY=

# Euri AI gateway (https://euron.one/euri) -- OpenAI-compatible, routes to Claude/OpenAI/Gemini/etc.
EURI_API_KEY=
# Optional -- defaults to https://api.euron.one/api/v1 if unset
EURI_API_BASE=
# Optional fallback only. Pick the model per call in code -- don't rely on this for real pipeline calls.
EURI_DEFAULT_MODEL=
