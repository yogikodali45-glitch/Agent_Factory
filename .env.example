# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key -- server-only, never expose to the browser, never commit
SUPABASE_SERVICE_ROLE_KEY=

# Euri AI gateway (https://euri.ai) -- OpenAI-compatible, routes to 40+ models
EURI_API_KEY=
# Optional -- defaults to https://api.euron.one/api/v1/euri if unset
EURI_API_BASE=
# Optional fallback only -- gpt-4o-mini is free-tier eligible (10k tokens/day).
# Pick the model per call in code once a stage needs something stronger.
EURI_DEFAULT_MODEL=gpt-4o-mini
